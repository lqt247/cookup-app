<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Cute Chef mascot illustration -->
        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/character_chef_1"
            android:scaleType="fitCenter" />

        <!-- Congratulations Title -->
        <TextView
            android:id="@+id/tvDialogSuccessTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Chúc mừng Đầu Bếp! 🎉"
            android:textColor="@color/orange_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center" />

        <!-- Message Body -->
        <TextView
            android:id="@+id/tvDialogSuccessMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Bạn đã hoàn thành xuất sắc món ăn. Hãy chụp hình chia sẻ và thưởng thức thành quả cùng gia đình thân yêu nhé!"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25" />

        <!-- Celebrate Confirm Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogSuccessClose"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="Thưởng thức ngay!"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="@color/orange_primary"
            app:cornerRadius="24dp"
            android:fontFamily="@font/poppins_bold"
            app:elevation="4dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
