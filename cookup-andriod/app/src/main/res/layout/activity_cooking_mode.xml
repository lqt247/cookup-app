<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:padding="20dp">

    <!-- Top Navigation Row -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnCookingClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/bg_card"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Pin Screen Awake Toggle Badge -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnCookingAwake"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF"
        app:cardBackgroundColor="#CC1E1410"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/btnCookingClose"
        app:layout_constraintEnd_toEndOf="parent"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/imgAwakeIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_pin"
                app:tint="@color/text_secondary"/>

            <TextView
                android:id="@+id/tvAwakeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="MÀN HÌNH SÁNG"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_semibold"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Step Progress Text -->
    <TextView
        android:id="@+id/tvCookingStepProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Bước 2 / 5"
        android:textColor="@color/orange_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_bold"
        app:layout_constraintTop_toBottomOf="@id/btnCookingClose"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Progress Indicator Bar -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/cookingProgressBar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:value="40"
        app:trackColor="#33FFFFFF"
        app:indicatorColor="@color/orange_primary"
        app:trackCornerRadius="2dp"
        app:layout_constraintTop_toBottomOf="@id/tvCookingStepProgress" />

    <!-- Central Instructions Text (Scalable & Large) -->
    <ScrollView
        android:id="@+id/scrollInstructions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/cookingProgressBar"
        app:layout_constraintBottom_toTopOf="@id/layoutTimerCircle">

        <TextView
            android:id="@+id/tvCookingInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Cho dầu ăn vào chảo nóng, phi thơm hành tỏi băm nhỏ cho đến khi vàng đều."
            android:textColor="@color/text_primary"
            android:textSize="25sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.25"
            android:fontFamily="@font/poppins_semibold" />
    </ScrollView>

    <!-- Timer Circle Frame -->
    <RelativeLayout
        android:id="@+id/layoutTimerCircle"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_circle_button"
        android:backgroundTint="#1F1410"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@id/cardStepIngredients"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/timerProgressIndicator"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_centerInParent="true"
            app:trackColor="#15FFFFFF"
            app:indicatorColor="@color/orange_primary"
            app:trackThickness="6dp"
            app:indicatorSize="180dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Small Timer Icon inside -->
            <ImageView
                android:id="@+id/imgTimerIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_time_clock"
                app:tint="@color/orange_primary" />

            <!-- Timer Countdown Text -->
            <TextView
                android:id="@+id/tvCookingTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02:30"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_bold" />

            <!-- State instruction (Chạm để Bắt đầu/Tạm dừng) -->
            <TextView
                android:id="@+id/tvTimerState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Chạm để bắt đầu"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:fontFamily="@font/poppins_medium"/>
        </LinearLayout>
    </RelativeLayout>

    <!-- Ingredients for this step section -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStepIngredients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/bg_card"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_food_category"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="NGUYÊN LIỆU BƯỚC NÀY"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:fontFamily="@font/poppins_bold" />
            </LinearLayout>

            <!-- Horizontal list of ingredient chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/containerStepIngredients"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <!-- Populated programmatically -->
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Navigation Row -->
    <LinearLayout
        android:id="@+id/layoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Back Step Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCookingPrev"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text=" Trước"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/text_primary"
            app:backgroundTint="@color/bg_card"
            app:cornerRadius="28dp"
            android:fontFamily="@font/poppins_semibold"/>

        <!-- Next / Finish Step Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCookingNext"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:text="Tiếp theo"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/orange_primary"
            app:cornerRadius="28dp"
            android:fontFamily="@font/poppins_bold"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
