<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="120dp">

        <!-- Toolbar bar container -->
        <RelativeLayout
            android:id="@+id/toolbarContainer"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="16dp">

            <!-- Avatar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/bg_card">

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Profile"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_default_unknown" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Center title -->
            <TextView
                android:id="@+id/tvHomeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppins_semibold"
                android:text="Hôm nay nấu gì?"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Notification -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNotification"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/bg_card">

                <ImageView
                    android:id="@+id/imgNotification"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Notifications"
                    android:src="@drawable/ic_notification"
                    app:tint="#FF7238" />
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>

        <!-- Hero Card (Promoted Recipe) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHeroRecipe"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/bg_card"
            android:clickable="true"
            android:focusable="true">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Main visual photo -->
                <ImageView
                    android:id="@+id/imgHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/character_chef_1" />

                <!-- Bottom Gradient Overlay for typography readability -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_alignParentBottom="true"
                    android:background="@drawable/bg_gradient_card" />

                <!-- Overlay content at bottom -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Country and Highlight chips row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal">

                        <!-- Món Việt Chip -->
                        <TextView
                            android:id="@+id/tvHeroCountryChip"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_chip_selected"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="🇻🇳 Món Việt"
                            android:textColor="#FF7238"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginEnd="8dp" />

                        <!-- Nổi bật Chip -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_segment_active"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="🔥 Nổi bật"
                            android:textColor="#FFF1ED"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_semibold" />
                    </LinearLayout>

                    <!-- Big Title -->
                    <TextView
                        android:id="@+id/tvHeroName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Phở Bò Gia Truyền"
                        android:textColor="#FFF1ED"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Stats Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Cook Time -->
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_time_clock"
                            app:tint="#FF7238" />

                        <TextView
                            android:id="@+id/tvHeroCookTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="2 Giờ"
                            android:textColor="#8F756C"
                            android:textSize="13sp"
                            android:layout_marginEnd="16dp" />

                        <!-- Rating -->
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_star"
                            app:tint="#FF7238" />

                        <TextView
                            android:id="@+id/tvHeroRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="4.9 (1.2k)"
                            android:textColor="#8F756C"
                            android:textSize="13sp"
                            android:layout_marginEnd="16dp" />

                        <!-- Calories -->
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_calories"
                            app:tint="#FF7238" />

                        <TextView
                            android:id="@+id/tvHeroCalories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="450 kcal"
                            android:textColor="#8F756C"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section: Công thức nổi bật -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/poppins_semibold"
                android:text="Công thức nổi bật"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnViewAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/poppins_semibold"
                android:text="Xem tất cả"
                android:textColor="#FF7238"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFeatured"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="24dp"
            android:scrollbars="none" />

        <!-- Section: Mới nhất -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Mới nhất"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNewest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
