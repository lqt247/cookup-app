<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Main Vertical Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar bar container -->
        <RelativeLayout
            android:id="@+id/toolbarContainer"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="16dp">

            <!-- Avatar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/bg_card">

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Profile"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_default_unknown" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Center title -->
            <TextView
                android:id="@+id/tvHomeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppins_semibold"
                android:text="Hôm nay nấu gì?"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Notification -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNotification"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/bg_card">

                <ImageView
                    android:id="@+id/imgNotification"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Notifications"
                    android:src="@drawable/ic_notification"
                    app:tint="#FF7238" />
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>

        <!-- Container chính hoán đổi giữa Content và Empty State -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 1. Content ScrollView -->
            <ScrollView
                android:id="@+id/scrollHomeContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="120dp">

                    <!-- Hero Card (Promoted Recipe) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardHeroRecipe"
                        android:layout_width="match_parent"
                        android:layout_height="420dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@color/bg_card"
                        android:clickable="true"
                        android:focusable="true">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <!-- Main visual photo -->
                            <ImageView
                                android:id="@+id/imgHero"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/character_chef_1" />

                            <!-- Bottom Gradient Overlay for typography readability -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="200dp"
                                android:layout_alignParentBottom="true"
                                android:background="@drawable/bg_gradient_card" />

                            <!-- Overlay content at bottom -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <!-- Country and Highlight chips row -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="12dp"
                                    android:orientation="horizontal">

                                    <!-- Món Việt Chip -->
                                    <TextView
                                        android:id="@+id/tvHeroCountryChip"
                                        android:layout_width="wrap_content"
                                        android:layout_height="28dp"
                                        android:background="@drawable/bg_chip_selected"
                                        android:gravity="center"
                                        android:paddingHorizontal="10dp"
                                        android:text="Mon Viet"
                                        android:textColor="#FF7238"
                                        android:textSize="11sp"
                                        android:textStyle="bold"
                                        android:fontFamily="@font/poppins_semibold"
                                        android:layout_marginEnd="8dp" />

                                    <!-- Nổi bật Chip -->
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="28dp"
                                        android:background="@drawable/bg_segment_active"
                                        android:gravity="center"
                                        android:paddingHorizontal="10dp"
                                        android:text="Noi bat"
                                        android:textColor="#FFF1ED"
                                        android:textSize="11sp"
                                        android:textStyle="bold"
                                        android:fontFamily="@font/poppins_semibold" />
                                </LinearLayout>

                                <!-- Big Title -->
                                <TextView
                                    android:id="@+id/tvHeroName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:text="Pho Bo Gia Truyen"
                                    android:textColor="#FFF1ED"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="12dp" />

                                <!-- Stats Row -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@drawable/ic_time_clock"
                                        app:tint="#FF7238" />

                                    <TextView
                                        android:id="@+id/tvHeroCookTime"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:fontFamily="@font/poppins_regular"
                                        android:text="2 Gio"
                                        android:textColor="#8F756C"
                                        android:textSize="13sp"
                                        android:layout_marginEnd="16dp" />

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@drawable/ic_star"
                                        app:tint="#FF7238" />

                                    <TextView
                                        android:id="@+id/tvHeroRating"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:fontFamily="@font/poppins_regular"
                                        android:text="4.9"
                                        android:textColor="#8F756C"
                                        android:textSize="13sp"
                                        android:layout_marginEnd="16dp" />

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@drawable/ic_calories"
                                        app:tint="#FF7238" />

                                    <TextView
                                        android:id="@+id/tvHeroCalories"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:fontFamily="@font/poppins_regular"
                                        android:text="450 kcal"
                                        android:textColor="#8F756C"
                                        android:textSize="13sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Section: Công thức nổi bật -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Công thức nổi bật"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnViewAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Xem tất cả"
                            android:textColor="#FF7238"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFeatured"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingHorizontal="16dp"
                        android:layout_marginBottom="24dp"
                        android:scrollbars="none" />

                    <!-- Section: Mới nhất -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Mới nhất"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnViewAllNewest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Xem tất cả"
                            android:textColor="#FF7238"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvNewest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingHorizontal="16dp"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>
            </ScrollView>

            <!-- 2. Empty State View -->
            <LinearLayout
                android:id="@+id/layoutEmptyHomeState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:src="@drawable/character_chef_1"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa có công thức nào!"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gian bếp hiện đang trống trải. Hãy là người đầu tiên chia sẻ công thức nấu ăn tuyệt vời của bạn nhé! 🍳"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyStateUpload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Đăng công thức ngay"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/orange_primary"
                    app:cornerRadius="24dp"
                    android:paddingHorizontal="24dp" />

            </LinearLayout>

        </FrameLayout>
    </LinearLayout>
</FrameLayout>
