<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Drag handle icon -->
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_drag_handle"
        android:layout_marginEnd="6dp"
        app:tint="#4A3B36" />

    <!-- Container block matching the screenshot's look -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_weight="1"
        android:background="@drawable/bg_edittext_outline"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <!-- Quantity Input -->
        <EditText
            android:id="@+id/edtIngredientQty"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center_vertical"
            android:hint="500g"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="#FFF1ED"
            android:textColorHint="#5A4A45"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Vertical separator -->
        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="8dp"
            android:background="#4A3B36" />

        <!-- Name Input -->
        <EditText
            android:id="@+id/edtIngredientName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center_vertical"
            android:hint="Thịt bò thăn"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="#FFF1ED"
            android:textColorHint="#5A4A45"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Delete action -->
    <ImageView
        android:id="@+id/btnDeleteIngredient"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Xóa nguyên liệu"
        android:padding="10dp"
        android:src="@drawable/ic_delete"
        app:tint="#8F756C" />
</LinearLayout>
