<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#150C0A">

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btnSubmitContainer"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp">

                <!-- Back button in circle background -->
                <FrameLayout
                    android:id="@+id/btnBackFrame"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_segment_inactive"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Quay lai"
                        android:padding="10dp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="#FFF1ED" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Đăng công thức"
                    android:textColor="#FFF1ED"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Menu button -->
                <ImageView
                    android:id="@+id/btnMore"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Tùy chọn"
                    android:padding="8dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="#FFF1ED" />
            </RelativeLayout>

            <!-- Image placeholder box -->
            <LinearLayout
                android:id="@+id/boxAddImage"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_dashed_border"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgRecipePreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:scaleType="centerCrop"
                    android:contentDescription="Ảnh xem trước" />

                <LinearLayout
                    android:id="@+id/layoutUploadPrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:src="@drawable/ic_camera_add"
                        app:tint="#FF7238" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="THÊM ẢNH MÓN ĂN"
                        android:textColor="#FFF1ED"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Chất lượng cao, tỷ lệ 4:3"
                        android:textColor="#8F756C"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- TÊN MÓN section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="TÊN MÓN"
                android:textColor="#8F756C"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtRecipeName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_edittext_outline"
                android:fontFamily="@font/poppins_regular"
                android:hint="Vd: Phở Bò Nam Định"
                android:inputType="textCapWords"
                android:paddingHorizontal="16dp"
                android:textColor="#FFF1ED"
                android:textColorHint="#5A4A45"
                android:textSize="14sp" />

            <!-- MÔ TẢ NGẮN section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="MÔ TẢ NGẮN"
                android:textColor="#8F756C"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtDescription"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_edittext_outline"
                android:fontFamily="@font/poppins_regular"
                android:gravity="top|start"
                android:hint="Chia sẻ câu chuyện hoặc hương vị đặc trưng của món ăn này..."
                android:inputType="textMultiLine"
                android:padding="16dp"
                android:textColor="#FFF1ED"
                android:textColorHint="#5A4A45"
                android:textSize="14sp" />

            <!-- THỜI GIAN NẤU and KHẨU PHẦN side-by-side -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="THỜI GIAN NẤU"
                        android:textColor="#8F756C"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_edittext_outline"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_time_clock"
                            app:tint="#8F756C" />

                        <EditText
                            android:id="@+id/edtCookTime"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/poppins_regular"
                            android:hint="Phút"
                            android:inputType="number"
                            android:paddingStart="8dp"
                            android:paddingEnd="0dp"
                            android:textColor="#FFF1ED"
                            android:textColorHint="#5A4A45"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="KHẨU PHẦN"
                        android:textColor="#8F756C"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_edittext_outline"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_people"
                            app:tint="#8F756C" />

                        <EditText
                            android:id="@+id/edtServings"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/poppins_regular"
                            android:hint="Người"
                            android:inputType="number"
                            android:paddingStart="8dp"
                            android:paddingEnd="0dp"
                            android:textColor="#FFF1ED"
                            android:textColorHint="#5A4A45"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ĐỘ KHÓ selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="ĐỘ KHÓ"
                android:textColor="#8F756C"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Horizontal Segmented Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="24dp"
                android:background="#211714"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/btnDifficultyEasy"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_active"
                    android:gravity="center"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Dễ"
                    android:textColor="#FFF1ED"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnDifficultyMedium"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Trung bình"
                    android:textColor="#8F756C"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnDifficultyHard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Khó"
                    android:textColor="#8F756C"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Divider Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2D1F1A"
                android:layout_marginBottom="20dp" />

            <!-- Title section: Phân loại -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Phân loại"
                android:textColor="#FFF1ED"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- QUỐC GIA category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="QUỐC GIA"
                android:textColor="#8F756C"
                android:textSize="11sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutCountries"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Country Chips -->
                    <TextView
                        android:id="@+id/chipCountryVN"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_selected"
                        android:gravity="center"
                        android:layout_marginEnd="8dp"
                        android:paddingHorizontal="16dp"
                        android:text="Việt Nam"
                        android:textColor="#FF7238"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipCountryKR"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:layout_marginEnd="8dp"
                        android:paddingHorizontal="16dp"
                        android:text="Hàn Quốc"
                        android:textColor="#FFF1ED"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipCountryJP"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:layout_marginEnd="8dp"
                        android:paddingHorizontal="16dp"
                        android:text="Nhật Bản"
                        android:textColor="#FFF1ED"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipCountryEU"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:layout_marginEnd="8dp"
                        android:paddingHorizontal="16dp"
                        android:text="Âu"
                        android:textColor="#FFF1ED"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- LOẠI MÓN & KHẨU VỊ category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="LOẠI MÓN &amp; KHẨU VỊ"
                android:textColor="#8F756C"
                android:textSize="11sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutTags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Add button tag -->
                    <LinearLayout
                        android:id="@+id/btnAddTag"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:layout_marginEnd="8dp"
                        android:paddingHorizontal="12dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_add"
                            app:tint="#8F756C" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Thêm thẻ"
                            android:textColor="#8F756C"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Example Tag 1 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:layout_marginEnd="8dp"
                        android:paddingHorizontal="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Món mặn"
                            android:textColor="#FFF1ED"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_close"
                            app:tint="#8F756C" />
                    </LinearLayout>

                    <!-- Example Tag 2 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:layout_marginEnd="8dp"
                        android:paddingHorizontal="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ăn tối"
                            android:textColor="#FFF1ED"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_close"
                            app:tint="#8F756C" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Divider Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2D1F1A"
                android:layout_marginBottom="20dp" />

            <!-- Title section: Nguyên liệu -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Nguyên liệu"
                    android:textColor="#FFF1ED"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnAddIngredient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="+ THÊM"
                    android:textColor="#FF7238"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <!-- Dynamic Ingredients List Container -->
            <LinearLayout
                android:id="@+id/containerIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="vertical" />

            <!-- Divider Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2D1F1A"
                android:layout_marginBottom="20dp" />

            <!-- Title section: Các bước -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Các bước"
                    android:textColor="#FFF1ED"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnAddStep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="+ THÊM"
                    android:textColor="#FF7238"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <!-- Dynamic Steps List Container -->
            <LinearLayout
                android:id="@+id/containerSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Fixed Bottom Button Area with elevation & blur/solid background -->
    <LinearLayout
        android:id="@+id/btnSubmitContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#150C0A"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveRecipe"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Gửi công thức"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_semibold"
            app:icon="@drawable/ic_send"
            app:iconPadding="10dp"
            app:iconGravity="textStart"
            app:backgroundTint="#FF7238"
            app:cornerRadius="28dp" />
    </LinearLayout>

</RelativeLayout>
